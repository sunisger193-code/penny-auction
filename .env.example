# ==============================================================================
# AURUM 8-BIT REAL-TIME PENNY AUCTION - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION
# ------------------------------------------------------------------------------
# For Local Development / Single Container (Render/Railway/Docker/VPS):
DATABASE_URL="file:./dev.db"

# For Serverless Cloud Deployment (Netlify / Vercel / Supabase / Neon PostgreSQL):
# 1. Copy prisma/schema.postgresql.prisma to prisma/schema.prisma (or run npm run db:push:pg)
# 2. Provide your cloud PostgreSQL connection string:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?sslmode=require"

# ------------------------------------------------------------------------------
# 2. REDIS DISTRIBUTED LOCKS (OPTIONAL)
# ------------------------------------------------------------------------------
# If running locally or on Redis Cloud / Upstash:
# REDIS_URL="redis://localhost:6379"
# REDIS_URL="rediss://default:[PASSWORD]@[HOST]:6379"
#
# NOTE: If REDIS_URL is omitted or unreachable, the application automatically
# falls back to the high-speed in-memory atomic mutex engine without errors.

# ------------------------------------------------------------------------------
# 3. WEBSOCKET REAL-TIME SERVER URL (OPTIONAL)
# ------------------------------------------------------------------------------
# Leave blank when deploying standard full-stack Node.js server (same host).
# If hosting the Next.js frontend on Netlify / Vercel and running the Socket.io
# server on a separate service (Railway / Render / VPS), set the public URL here:
# NEXT_PUBLIC_SOCKET_URL="https://your-socket-server.up.railway.app"
#
# NOTE: If running on Netlify without an external socket server, the frontend
# automatically switches to cloud polling (every 2s) so auctions remain 100% active!

# ------------------------------------------------------------------------------
# 4. MASTER ADMIN SECURITY PASSKEY & SECRETS
# ------------------------------------------------------------------------------
# Level 5 Security Passkey required to unlock the /admin console
ADMIN_SECURITY_TOKEN="AURUM-ADMIN-8888-MASTER"

# JWT Secret for signing session auth tokens (generate a strong random string)
JWT_SECRET="retro_penny_auction_jwt_arcade_secret_2026_xyz"

# 32-byte (64 hex characters) cryptographic encryption key
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME PORT
# ------------------------------------------------------------------------------
PORT=3000
